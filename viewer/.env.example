# Duxo Viewer — environment template.
# Copy to .env.local and fill from your Firebase project. NEVER commit .env.local.

# Clerk Auth (free tier, 10K MAU) — https://clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Firebase Spark plan (§0.3) — no card required for Path A.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server-side only, for /api/firebase-token)
# Get these from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Metered.ca TURN (§0.5) — 50GB/mo free, no card required.
#
# REQUIRED for §0.8. Without it, sessions still work peer-to-peer but fail
# outright on roughly 10-15% of networks — and they fail for the remote
# person, not for you, which makes it the hardest thing here to notice.
#
# The old no-signup credentials (openrelay.metered.ca / openrelayproject)
# are dead — the host no longer resolves — so an account is genuinely needed.
# Sign up at https://www.metered.ca/tools/openrelay/ and paste the values
# below, then verify them with:  npm run check:turn
#
# Comma-separated list of TURN URLs.
NEXT_PUBLIC_METERED_TURN_URLS=turn:turn.metered.ca:80?transport=udp,turn:turn.metered.ca:443?transport=tcp
NEXT_PUBLIC_METERED_TURN_USERNAME=
NEXT_PUBLIC_METERED_TURN_CREDENTIAL=
