{
  "name": "duxo-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Duxo — web-based remote desktop viewer (Windows + Linux)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "type-check": "tsc --noEmit",
    "check:turn": "node scripts/check-turn.mjs",
    "check:backend": "node scripts/check-backend.mjs",
    "check:deploy": "node scripts/check-deployment.mjs",
    "test:rules": "npx -y firebase-tools@14 emulators:exec --only database --project demo-duxo --config ../firebase.json \"npx vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.0",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-label": "^2.1.12",
    "@radix-ui/react-separator": "^1.1.12",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-toggle": "^1.1.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.4.0",
    "firebase-admin": "^13.10.0",
    "lucide-react": "^1.40.0",
    "next": "^16.3.4",
    "otpauth": "^9.5.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.14.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.6",
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.39",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  }
}
