# Duxo host agent configuration (§7.6).
# These are the same public Firebase web-app values the viewer ships in its
# client bundle — none of them is a secret. The only real credential the host
# ever holds is the refresh token, which lives in the OS keychain (§2.6).
#
# This file is for running from source. A *released* build never sees it: the
# archive holds the binary and nothing else, so the same four variables are
# read at COMPILE time as well (`option_env!` in tray.rs) and baked in. Set
# them as repository variables and release.yml passes them to cargo; it refuses
# to publish without them, because a binary with no configuration starts with
# every tray item greyed out.
#
# A value set here at runtime always wins over the baked-in one, so this file
# keeps working for `cargo tauri dev`. Leaving a line blank is NOT an override —
# an empty value falls through to whatever was baked in.

DUXO_FIREBASE_API_KEY=
DUXO_FIREBASE_DATABASE_URL=
DUXO_FIREBASE_PROJECT_ID=

# Where the user goes to approve a device pairing (auth.rs), which shows them
# "{DUXO_WEB_APP_URL}/link-device". For a release this must be the deployment
# the viewer actually runs on — the compiled-in fallback is a placeholder
# domain, and pairing sends people there if nothing better is set.
DUXO_WEB_APP_URL=http://localhost:3000

# §0.5/§0.8 — Metered TURN. Without these, sessions on restrictive networks
# (roughly 10-15% of them) cannot connect at all.
DUXO_METERED_TURN_URLS=
DUXO_METERED_TURN_USERNAME=
DUXO_METERED_TURN_CREDENTIAL=
