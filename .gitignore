# Secrets — NEVER commit
.env
.env.local
.env.*.local
*.pem
*.p12
*.key
# §7.1 — the updater signing keypair. The private half must never be
# committed; the public half belongs in tauri.conf.json, not here.
host-agent/src-tauri/updater-keys/
serviceAccount*.json
oauth*.json
firebase-*.json

# Dependencies
node_modules/
host-agent/src-tauri/node_modules/

# Rust / Tauri
target/
host-agent/src-tauri/target/

# Next.js
.next/
out/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.wasm
.playwright-mcp/

# Screenshots and scratch captures, but never the assets the build needs:
# tauri.conf.json -> bundle.icon requires host-agent/src-tauri/icons/*.png,
# and viewer/public is served as-is.
/*.png
screenshots/

# Playwright output — regenerated on every run, never reviewed in a diff.
viewer/test-results/
viewer/playwright-report/

# Deploy debris captured while debugging Railway; not part of the project.
railway-build-log.txt
railway-service.txt

# Locally installed agent skill packages — developer tooling, not project
# source. ~4MB of vendored third-party content (with its own licenses and a
# binary tarball) that no part of the viewer or host agent builds against.
# .claude/skills holds only symlinks into .agents/skills.
# The ** prefix matters on the second pattern: a pattern with an internal
# slash is anchored to this file's directory, so a bare `.claude/skills/`
# would only match at the repo root and miss viewer/.claude/skills/.
.agents/
**/.claude/skills/
skills-lock.json
