// Duxo — RTDB Security Rules (§10.2, full & deployable).
//
// RTDB is for LIVE signaling only (ICE candidates, offer/answer, status).
// Durable records live in Firestore (§6.3, §10.1) — never write per-frame
// or per-input-event data here, it blows the quota.
//
// DEVIATION FROM §10.2 (deliberate, and required for the product to work):
// the plan's `.write` rule is `hostId == auth.uid || viewerId == auth.uid ||
// !data.exists()`. A viewer joining a session created by the host matches
// none of those — the node exists, hostId is the host, and viewerId is still
// null — so §1.6-B's "write viewerId + ID token to session" was rejected at
// the rule layer and no session could ever reach REQUESTED. The extra clause
// below is the *claim*: an authenticated viewer may attach itself to a
// session that is still WAITING and still unclaimed, and only by setting
// viewerId to its own uid. Everything else about §10.2 is unchanged.
{
  "rules": {
    "sessions": {
      "$sessionId": {
        // §0.7 — host and viewer only. Hijacking blocked at rule layer.
        ".read": "auth != null && (data.child('hostId').val() == auth.uid || data.child('viewerId').val() == auth.uid)",
        ".write": "auth != null && (data.child('hostId').val() == auth.uid || data.child('viewerId').val() == auth.uid || !data.exists() || (data.child('viewerId').val() == null && data.child('status').val() == 'waiting' && newData.child('viewerId').val() == auth.uid))",
        ".validate": "newData.child('createdAt').val() <= now",
        // §1.1 — explicit enum, no loose strings ("Allowed" vs "allowed").
        "status": {
          ".validate": "newData.val() == 'waiting' || newData.val() == 'requested' || newData.val() == 'allowed' || newData.val() == 'denied' || newData.val() == 'connecting' || newData.val() == 'active' || newData.val() == 'ended' || newData.val() == 'expired'"
        },
        // §6.3 — must match viewer/shared/types.ts HostPlatform exactly.
        "hostPlatform": {
          ".validate": "newData.val() == 'windows' || newData.val() == 'linux-x11' || newData.val() == 'linux-wayland'"
        },
        // §0.6 — SDP 10KB cap, ICE batching max 10 per write.
        "offer":   { ".validate": "newData.isString() && newData.val().length <= 10000" },
        "answer":  { ".validate": "newData.isString() && newData.val().length <= 10000" },
        // §2.5 — the viewer's Firebase ID token, read once by the host for
        // local signature verification. Only the viewer may write it.
        "viewerToken": {
          ".validate": "newData.isString() && newData.val().length <= 4096 && newData.parent().child('viewerId').val() == auth.uid"
        },
        // §6.1 — the viewer's declared wire protocol and capabilities, written
        // with the claim. Only the viewer may write them, and the shape is
        // pinned here so a malformed version string is refused at the rule
        // layer rather than becoming a parse error on the host.
        "protocolVersion": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$/) && newData.parent().child('viewerId').val() == auth.uid"
        },
        "capabilities": {
          ".validate": "newData.parent().child('viewerId').val() == auth.uid",
          "$index": { ".validate": "newData.isString() && newData.val().length <= 40" }
        },
        "hostCandidates":   { "$index": { ".validate": "$index.matches(/^([0-9]|[1-9][0-9])$/) && newData.isString() && newData.val().length <= 1000" } },
        "viewerCandidates": { "$index": { ".validate": "$index.matches(/^([0-9]|[1-9][0-9])$/) && newData.isString() && newData.val().length <= 1000" } }
      }
    },
    // §0.7 — the code → sessionId mapping.
    //
    // Read is denied to every client. It used to be `auth != null`, which made
    // the 8-digit space enumerable by anyone who could sign up: §0.7 pairs
    // "100M combinations" with "5 attempts/min per IP", and only the first
    // half existed — the `rateLimit` node below never had anything writing to
    // it. Viewers now resolve a code through /api/resolve-code, which holds
    // the Admin credential (rules do not apply to it) and does the counting.
    //
    // Write is create-or-delete by the owning host, never overwrite. With
    // `auth != null` an attacker could repoint a live code at a session of
    // their own, so the person reading a code down the phone would connect to
    // a machine that is not the one they were told about.
    "codes": {
      "$code": {
        ".read": false,
        ".write": "auth != null && $code.length == 8 && ((!data.exists() && newData.child('hostId').val() == auth.uid) || data.child('hostId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['sessionId', 'hostId']) && newData.child('hostId').val() == auth.uid",
        "sessionId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "hostId":    { ".validate": "newData.isString() && newData.val().length <= 128" }
      }
    },
    // Device pairing — how the host agent obtains a credential at all.
    //
    // The host has no Firebase identity yet, so it must be able to create its
    // own node unauthenticated. That is safe only because the node carries no
    // secret in the direction the host writes: it publishes a device name and
    // platform, and the *server* (which holds the service-account key) is the
    // only party that can add a `customToken`.
    //
    // Read is restricted to the single `customToken` child so an unauthenticated
    // caller cannot enumerate pending pairings or read device names.
    "pairings": {
      "$code": {
        // Two permitted writes, and only two: an anonymous create, and an
        // authenticated DELETE.
        //
        // The create must be anonymous — the host has no Firebase identity
        // until this exchange gives it one, which is the whole point of the
        // node. It must not arrive pre-claimed, or an attacker could park a
        // poisoned pairing that the server then refuses to issue against.
        //
        // The delete is the host retiring its own node once it has exchanged
        // the custom token (auth.rs::delete_pairing); an unauthenticated
        // delete can never match the create clause, since `data.exists()`.
        //
        // The second clause was previously a bare `auth != null`, which
        // granted every signed-in account full write on every pairing node.
        // Verified against the emulator: a stranger could rewrite the
        // deviceName the user is about to confirm, set `claimed` to strand a
        // real device, or inject a bogus customToken for the host to choke
        // on. `!newData.exists()` narrows it to the delete that was actually
        // needed. The server does not need a clause at all — it holds the
        // Admin credential, which bypasses rules.
        //
        // A signed-in caller who guesses a live code can still delete it.
        // There is no owner recorded on the node to bind against (there
        // cannot be, before the host has an identity), so this is as tight as
        // the rule layer goes: a 10-minute DoS window against one of 31^6
        // codes, versus the credential tampering the old clause allowed.
        //
        // `!= true` rather than `!...val()`: a pairing the host is creating has
        // no `claimed` child at all, so `.val()` is null, and RTDB's `!` is
        // typed — "! only operates on booleans" — which made the whole ruleset
        // fail to compile. Not this rule: the file. Every deploy would have
        // been rejected, and the only way to find out was to attempt one.
        ".write": "(!data.exists() && newData.child('claimed').val() != true) || (auth != null && !newData.exists())",
        ".validate": "newData.hasChildren(['deviceName', 'platform', 'createdAt'])",
        "deviceName": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "platform":   { ".validate": "newData.val() == 'windows' || newData.val() == 'linux-x11' || newData.val() == 'linux-wayland'" },
        "appVersion": { ".validate": "newData.isString() && newData.val().length <= 32" },
        // §6.1/§8.2 — recorded into the device registry when the pairing is
        // claimed, so the shape is pinned here like every other field the
        // server reads back out of this node.
        "protocolVersion": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{1,3}[.][0-9]{1,3}[.][0-9]{1,3}$/)" },
        "createdAt":  { ".validate": "newData.val() <= now" },
        "claimed":    { ".validate": "newData.isBoolean()" },
        // Only the host polls this, and only it knows the code.
        "customToken": {
          ".read": true,
          ".validate": "newData.isString() && newData.val().length <= 4096"
        }
      }
    },
    // §7.3 — append-only audit chain.
    //
    // DEVIATION FROM §10.1, which puts auditLog in Firestore: the host agent's
    // audit.rs writes it to RTDB, and moving it would mean a second Firestore
    // client in the host for no gain. The append-only and own-uid-only
    // properties that §7.3's hash chain depends on are preserved here.
    "auditLog": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        // §7.3 — the chain tip: the hash the *next* append chains onto. It
        // has to be rewritable, and it was not: `_tip` matched the `$entryId`
        // wildcard below, whose whole point is `!data.exists()`. So the first
        // tip write was refused by that rule's `.validate` (a tip has no
        // uid/action/timestamp) and every later one by its `.write`. The tip
        // therefore never existed, `get_tip_hash` always returned None, and
        // every entry in the chain recorded previousHash "0" — a hash chain
        // in shape only, chaining nothing to anything.
        //
        // Overwriting the tip costs nothing the chain relies on: the tip is a
        // pointer, not evidence. The entries are still append-only, and they
        // are what a tamper check reads.
        "_tip": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['hash'])",
          "hash": { ".validate": "newData.isString() && newData.val().length <= 64" }
        },
        "$entryId": {
          // Append-only: an entry may be created but never rewritten, which is
          // what makes the prevHash chain meaningful.
          ".write": "auth != null && auth.uid == $uid && !data.exists()",
          ".validate": "newData.hasChildren(['uid', 'action', 'timestamp']) && newData.child('uid').val() == $uid && newData.child('timestamp').val() <= now"
        }
      }
    },
    "rateLimit": {
      "$ipHash": {
        // §0.7 — 5 attempts/min per IP, brute-force defense.
        ".read": false,
        ".write": "auth != null && (!data.exists() || data.child('count').val() < 5 || now - data.child('lastAttempt').val() > 60000)"
      }
    }
  }
}
